(version 1)
# JLCPCB 4-layer standard capabilities (conservative)
(rule "JLC track width" (condition "A.Type == 'track'") (constraint track_width (min 0.09mm)))
(rule "JLC clearance" (constraint clearance (min 0.09mm)))
(rule "JLC via hole" (condition "A.Type == 'via'") (constraint hole_size (min 0.3mm)))
(rule "JLC via diameter" (condition "A.Type == 'via'") (constraint via_diameter (min 0.45mm)))
(rule "JLC via annular" (condition "A.Type == 'via'") (constraint annular_width (min 0.075mm)))
(rule "JLC PTH annular" (condition "A.Type == 'pad' && A.isPlated()") (constraint annular_width (min 0.2mm)))
(rule "JLC hole to hole" (constraint hole_to_hole (min 0.254mm)))
(rule "JLC hole clearance" (constraint hole_clearance (min 0.2mm)))
(rule "JLC copper to edge" (constraint edge_clearance (min 0.3mm)))
(rule "JLC NPTH min" (condition "A.Type == 'pad' && !A.isPlated()") (constraint hole_size (min 0.5mm)))
(rule "JLC silk width" (layer "?.Silkscreen") (constraint text_thickness (min 0.15mm)))
(rule "JLC silk height" (layer "?.Silkscreen") (constraint text_height (min 1.0mm)))
(rule "JLC silk to pad" (layer "?.Silkscreen") (constraint silk_clearance (min 0.15mm)))
(rule "Router via to pad" (condition "A.Type == 'Via' && B.Type == 'Pad'") (constraint clearance (min 0.15mm)))
